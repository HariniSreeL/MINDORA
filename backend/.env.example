# Mindora Backend - Environment Variables Template
# Copy to .env for local development. Never commit a real .env file.

FLASK_ENV=development
FLASK_DEBUG=1
PORT=5000
HOST=0.0.0.0

# Use long random values in production (32+ characters).
SECRET_KEY=mindora_dev_secret_key_change_in_production_2026
JWT_SECRET_KEY=mindora_jwt_secret_key_change_in_production_2026
JWT_EXPIRATION_HOURS=72

# Persistent path in deployment, e.g. /data/mindora.db.
DATABASE_PATH=database/mindora.db

# Comma-separated origins in production, e.g. https://mindora.example.com
CORS_ORIGINS=*

# Demo data must be false in production.
SEED_DEMO_DATA=true

LOGIN_MAX_ATTEMPTS=8
LOGIN_WINDOW_SECONDS=300
PAIRING_CODE_TTL_MINUTES=15
